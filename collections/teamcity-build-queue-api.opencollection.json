{
  "opencollection": "1.0.0",
  "info": {
    "name": "TeamCity REST Agent Pools Build Queue API",
    "version": "2024.12.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Build Queue",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Build Queue",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}/app/rest/buildQueue",
            "params": [
              {
                "name": "locator",
                "value": "",
                "type": "query",
                "description": "TeamCity locator string to filter results"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Fields to include in the response (for partial responses)"
              }
            ]
          },
          "docs": "Returns the current build queue."
        },
        {
          "info": {
            "name": "Trigger Build",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{server}/app/rest/buildQueue",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a build to the build queue (triggers a build)."
        }
      ]
    }
  ],
  "bundled": true
}
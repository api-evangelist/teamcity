{
  "opencollection": "1.0.0",
  "info": {
    "name": "TeamCity REST Agent Pools Investigations API",
    "version": "2024.12.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Investigations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Investigations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}/app/rest/investigations",
            "params": [
              {
                "name": "locator",
                "value": "",
                "type": "query",
                "description": "TeamCity locator string to filter results"
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "Fields to include in the response (for partial responses)"
              }
            ]
          },
          "docs": "Returns a list of all investigations."
        }
      ]
    }
  ],
  "bundled": true
}